--- a/drivers/video/fbdev/omap2/omapfb/dss/display.c	2026-09-23 10:10:52.912977751 -0400
+++ b/drivers/video/fbdev/omap2/omapfb/dss/display.c	2026-09-23 10:10:52.928977747 -0400
@@ -295,7 +295,14 @@
 		OMAPDSS_DRIVE_SIG_RISING_EDGE :
 		OMAPDSS_DRIVE_SIG_FALLING_EDGE;
 
-	ovt->sync_pclk_edge = ovt->data_pclk_edge;
+	/* Honour DT syncclk-active when given; the vendor panel needs sync on
+	 * the falling edge with data on the rising one. */
+	if (vm->flags & DISPLAY_FLAGS_SYNC_POSEDGE)
+		ovt->sync_pclk_edge = OMAPDSS_DRIVE_SIG_RISING_EDGE;
