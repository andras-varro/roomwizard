musb_cleanup_urb(): do not spend ~1 s with IRQs off flushing the TX FIFO of
a device that is gone.

Behind an unplugged hub the TX FIFO never drains, and musb_h_tx_flush_fifo()
retries 1000 x mdelay(1) under musb->lock with IRQs off. dev_WARN_ONCE only
silences the second and later prints, not the stall. When the URB's device
is NOTATTACHED, try 10 times and report at dev_dbg; every other caller keeps
upstream's 1000 and its warning.

SPDX-License-Identifier: GPL-2.0-only

--- a/drivers/usb/musb/musb_host.c
+++ b/drivers/usb/musb/musb_host.c
@@ -108,12 +108,12 @@
 /*
  * Clear TX fifo. Needed to avoid BABBLE errors.
  */
-static void musb_h_tx_flush_fifo(struct musb_hw_ep *ep)
+static void musb_h_tx_flush_fifo_budget(struct musb_hw_ep *ep, int retries,
+					bool gone)
 {
 	struct musb	*musb = ep->musb;
 	void __iomem	*epio = ep->regs;
 	u16		csr;
-	int		retries = 1000;
 
 	csr = musb_readw(epio, MUSB_TXCSR);
 	while (csr & MUSB_TXCSR_FIFONOTEMPTY) {
@@ -135,14 +135,32 @@
 		 * Better to turn on musb_dbg() in musb_cleanup_urb() with
 		 * CPPI enabled to see the issue when aborting the tx channel.
 		 */
-		if (dev_WARN_ONCE(musb->controller, retries-- < 1,
-				"Could not flush host TX%d fifo: csr: %04x\n",
-				ep->epnum, csr))
+		if (retries-- < 1) {
+			if (gone)
+				dev_dbg(musb->controller,
+					"gone device: host TX%d fifo not flushed: csr: %04x\n",
+					ep->epnum, csr);
+			else
+				dev_WARN_ONCE(musb->controller, 1,
+					"Could not flush host TX%d fifo: csr: %04x\n",
+					ep->epnum, csr);
 			return;
+		}
 		mdelay(1);
 	}
 }
 
+/*
+ * A FIFO whose device is gone (behind an unplugged hub, say) never drains,
+ * and each try is 1 ms with IRQs off on a single core: 1000 tries made every
+ * recurrence a ~1 s stall that dev_WARN_ONCE only hid after the first. Live
+ * devices keep upstream's budget; musb_cleanup_urb() gives a gone one 10.
+ */
+static void musb_h_tx_flush_fifo(struct musb_hw_ep *ep)
+{
+	musb_h_tx_flush_fifo_budget(ep, 1000, false);
+}
+
 static void musb_h_ep0_flush_fifo(struct musb_hw_ep *ep)
 {
 	void __iomem	*epio = ep->regs;
@@ -2401,7 +2419,14 @@
 		if (is_dma_capable() && dma)
 			musb_platform_clear_ep_rxintr(musb, ep->epnum);
 	} else if (ep->epnum) {
-		musb_h_tx_flush_fifo(ep);
+		/* usb_disconnect() marks the device and all its children
+		 * NOTATTACHED before usb_disable_device() flushes their
+		 * endpoints, so this dequeue sees the device as gone.
+		 */
+		if (urb->dev && urb->dev->state == USB_STATE_NOTATTACHED)
+			musb_h_tx_flush_fifo_budget(ep, 10, true);
+		else
+			musb_h_tx_flush_fifo(ep);
 		csr = musb_readw(epio, MUSB_TXCSR);
 		csr &= ~(MUSB_TXCSR_AUTOSET
 			| MUSB_TXCSR_DMAENAB
