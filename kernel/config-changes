# Our changes to usb_host/device_config, applied by build-image.sh with scripts/config before
# olddefconfig and asserted in the final .config after it: an added symbol whose dependency is
# missing is dropped silently, and dropped-symbols.txt only sees symbols the vendor config had.
# One per line: `<scripts/config verb> <SYMBOL> [value]`; the verbs are enable, disable, set-str.

# The panel is the boot console, with Tux on top and the messages under it. U-Boot's bootargs
# cannot be persisted, so these are appended to them; console=tty0 comes last, which makes the
# panel /dev/console while ttyO1 keeps every printk. The vendor string " debug " is replaced,
# not extended: appended, it would raise the console loglevel to 10.
disable CMDLINE_FROM_BOOTLOADER
enable  CMDLINE_EXTEND
set-str CMDLINE vt.global_cursor_default=0 console=tty0
# The vendor config carries only the mono and 16-colour logos; on a 32bpp panel the 224-colour
# one is the one fb_find_logo() picks.
enable  LOGO_LINUX_CLUT224
# The vendor config leaves MUSB with neither a DMA backend nor PIO_ONLY, so omap2430_ops has no
# dma_init and musb_init_controller() fails with -ENODEV: no USB host at all. The vendor kernel
# hides this behind enable-usb-host.sh's /dev/mem stubs, whose addresses exist only in its image.
# PIO, not USB_INVENTRA_DMA: with the Inventra backend a USB audio stream never completes a period
# (hw_ptr stays 0, the MUSB dma IRQ never fires) and the writer blocks; PIO plays (.188, 2026-09-25).
enable  MUSB_PIO_ONLY
