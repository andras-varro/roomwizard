#!/bin/sh
# /etc/init.d/rwmond — boot start for the Monitor page's history daemon.
#
# rwmond samples CPU, memory and SoC temperature once a second into a two
# minute ring at /var/run/rwmond.ring (tmpfs), which control_panel's Monitor
# page reads on open.  The binary is a native_apps deploy (/opt/games/rwmond);
# on a unit without it this prints one line and does nothing.  It niced itself
# to 19 and opens no framebuffer or input device.
#
# native_apps/build-and-deploy.sh stops it with everything else in /opt/games
# (roomwizard-app stop matches on the executable) and calls "start" again.

DAEMON=/opt/games/rwmond
PIDFILE=/var/run/rwmond.pid

running() {
    [ -f "$PIDFILE" ] || return 1
    _pid=$(cat "$PIDFILE" 2>/dev/null)
    [ -n "$_pid" ] && [ "$(readlink "/proc/$_pid/exe" 2>/dev/null)" = "$DAEMON" ]
}

do_start() {
    if [ ! -x "$DAEMON" ]; then
        echo "rwmond: $DAEMON not installed (deploy native_apps)"
        return 0
    fi
    if running; then
        echo "rwmond: already running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
        --exec "$DAEMON"
    echo "rwmond: started"
}

do_stop() {
    if running; then
        kill "$(cat "$PIDFILE")" 2>/dev/null
    fi
    rm -f "$PIDFILE"
    echo "rwmond: stopped"
}

case "$1" in
    start)   do_start ;;
    stop)    do_stop ;;
    restart) do_stop; sleep 1; do_start ;;
    status)
        if running; then echo "rwmond: running (pid $(cat "$PIDFILE"))"
        else echo "rwmond: not running"; exit 1; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
exit 0
